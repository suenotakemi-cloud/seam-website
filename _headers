# Cloudflare Pages — caching policy
# 既定: HTML/JS/CSS/JSON/SW は常に再検証（即時デプロイ・陳腐化なし）
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=()

# 重い静的アセットは長期キャッシュ（?v= と sw VERSION でバスティング）
# vendor(babel 2.7MB 等) と画像/動画はリピート訪問で再DLしない
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=31536000, immutable

# 社内資料（スタッフ共有・検索エンジン非掲載）
/docs/*
  X-Robots-Tag: noindex, nofollow, noarchive

# 入場受付キオスク（スタッフ用・noindex）だけカメラを許可
# サイト全体は camera=() のまま。/entrance（ページ本体）と /entrance/*（API等）の両方に必要
/entrance
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), browsing-topics=()
/entrance/*
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), browsing-topics=()

# 商品登録（スタッフ用・noindex）もカメラ（JAN読み取り・撮影）を許可
/pim
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), browsing-topics=()
/pim/*
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), browsing-topics=()

